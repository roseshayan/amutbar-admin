Options -Indexes

<FilesMatch "(^\.|\.env|\.sql$|\.log$|\.bak$|\.backup$|composer\.(json|lock)$|package(-lock)?\.json$|key\.properties$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # فایل‌های عمومی در Flutter Web روی localhost نیز قابل بارگذاری باشند.
  <FilesMatch "\.(?i:png|jpe?g|webp|gif|svg|ico|woff2?|ttf|otf)$">
    Header always set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
