Options -Indexes

<FilesMatch "(^\.|\.env|\.sql$|\.log$|\.bak$|\.backup$|composer\.(json|lock)$|package(-lock)?\.json$|key\.properties$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "^guide_[a-f0-9]{32}\.mp4$">
    Header always set Access-Control-Allow-Origin "*"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # فایل‌های عمومی در Flutter Web روی localhost نیز قابل بارگذاری باشند.
  <FilesMatch "\.(?i:png|jpe?g|webp|gif|svg|ico|woff2?|ttf|otf)$">
    Header always set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

<IfModule mod_php.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 64M
  php_value memory_limit 256M
  php_value max_execution_time 300
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 64M
  php_value memory_limit 256M
  php_value max_execution_time 300
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 64M
  php_value memory_limit 256M
  php_value max_execution_time 300
</IfModule>
